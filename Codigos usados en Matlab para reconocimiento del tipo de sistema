%% CARGAR DATOS DESDE CSV
clear; close all; clc;

% Cargar datos
data_bmp = readtable('datos_bmp180.csv');
data_lm35 = readtable('datos_lm35.csv');

% Extraer vectores
t_bmp = data_bmp.Tiempo_s;
T_bmp = data_bmp.Temperatura_C;
t_lm35 = data_lm35.Tiempo_s;
T_lm35 = data_lm35.Temperatura_C;

% Crear señal de entrada (calor de manos)
% 1 = calor aplicado, 0 = sin calor
u_bmp = ones(size(t_bmp));
u_lm35 = ones(size(t_lm35));

% Detectar cuándo se retiran las manos (pico máximo)
[~, idx_pico_bmp] = max(T_bmp);
[~, idx_pico_lm35] = max(T_lm35);

u_bmp(idx_pico_bmp:end) = 0;
u_lm35(idx_pico_lm35:end) = 0;

fprintf('Datos cargados correctamente\n');
fprintf('BMP180: pico en t = %.1f s\n', t_bmp(idx_pico_bmp));
fprintf('LM35: pico en t = %.1f s\n', t_lm35(idx_pico_lm35));

%% CREAR OBJETOS PARA SYSTEM IDENTIFICATION
Ts = 0.2;  % Tiempo de muestreo (segundos)

% Objeto para BMP180
data_bmp_id = iddata(T_bmp, u_bmp, Ts);
data_bmp_id.InputName = 'Calor_Manos';
data_bmp_id.OutputName = 'Temperatura';
data_bmp_id.InputUnit = 'binario';
data_bmp_id.OutputUnit = '°C';

% Objeto para LM35
data_lm35_id = iddata(T_lm35, u_lm35, Ts);
data_lm35_id.InputName = 'Calor_Manos';
data_lm35_id.OutputName = 'Temperatura';
data_lm35_id.InputUnit = 'binario';
data_lm35_id.OutputUnit = '°C';

% Guardar objetos
save('datos_identificacion.mat', 'data_bmp_id', 'data_lm35_id', 't_bmp', 'T_bmp', 't_lm35', 'T_lm35', 'u_bmp', 'u_lm35');
fprintf('Objetos iddata guardados en datos_identificacion.mat\n');
